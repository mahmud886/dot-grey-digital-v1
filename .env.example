# Copy to .env.local for local development, or add these in Vercel → Project → Settings →
# Environment Variables. Without RESEND_API_KEY the forms still work: they open the
# visitor's email app instead (see DEPLOY.md).

# Resend API key (https://resend.com/api-keys), starts with re_
RESEND_API_KEY=

# Sender, on a domain you have verified in Resend. Name optional.
CONTACT_FROM_EMAIL="DotGrey Digital <website@dotgreydigital.com>"

# Where submissions are delivered. Defaults to the email in src/content/site.json.
CONTACT_TO_EMAIL=hello@dotgreydigital.com

# Optional: Resend segment (audience) id for newsletter signups. Empty = the signup is
# emailed to CONTACT_TO_EMAIL so you can add it by hand.
RESEND_AUDIENCE_ID=

# Optional: "true" also sends the visitor a short "thanks, we got it" email.
CONTACT_AUTOREPLY=false

# Optional: the site's public address, used for canonical URLs, the sitemap and share cards.
# NEXT_PUBLIC_SITE_URL=https://dotgreydigital.com

# Optional: Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Empty = no analytics, no cookie banner.
# Read at build time, so rebuild after changing it (also for `npm run build:static`). See ANALYTICS.md.
NEXT_PUBLIC_GA_ID=
